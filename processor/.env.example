# UPTAC Predictor – document processor (server-side only; never ship these values to a browser)

# Shared secret. The process-import Edge Function sends it in the X-Processor-Token header and
# the processor sends it back on callbacks. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PROCESSOR_TOKEN=

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=
# Service role key: used ONLY by this server to read/write the private storage bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: anon key used as the bearer token when calling the process-import Edge Function.
# Falls back to the service role key when empty.
SUPABASE_ANON_KEY=

# Storage buckets the processor may read from / write to (comma separated)
ALLOWED_BUCKETS=official-documents
# Edge Function that receives extraction callbacks
CALLBACK_FUNCTION=process-import

# Limits
MAX_FILE_MB=50
MAX_PDF_PAGES=1500
JOB_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS=2

LOG_LEVEL=INFO
# Expose interactive API docs at /docs (keep false in production)
ENABLE_DOCS=false
PORT=8080
