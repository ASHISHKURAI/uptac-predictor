# Edge Function secrets. Set in production with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Comma-separated allowed browser origins for CORS (e.g. https://uptac-predictor.vercel.app)
ALLOWED_ORIGINS=*
# Public site URL (used in notification links and the monitor User-Agent)
SITE_URL=http://localhost:5173

# Python PDF processor (processor/) – required only for PDF imports
PROCESSOR_URL=
PROCESSOR_TOKEN=

# Shared secret for scheduled monitor runs (pg_cron → monitor-uptac)
MONITOR_SECRET=

# Optional e-mail notifications via Resend (https://resend.com)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAILS=
NOTIFY_FROM_EMAIL=
