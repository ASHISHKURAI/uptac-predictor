# ---------------------------------------------------------------------------
# UPTAC Predictor – frontend environment (Vite). Copy to `.env.local`.
# Only PUBLIC values belong here. NEVER put the Supabase service_role key in
# any VITE_* variable – everything prefixed with VITE_ is shipped to browsers.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key: Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL (used for auth redirects, canonical URLs and sitemap)
VITE_SITE_URL=http://localhost:5173

# Optional: show "Continue with Google" (requires Google provider enabled in Supabase Auth)
VITE_ENABLE_GOOGLE_AUTH=false
